PORT=3000
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/skillio
JWT_SECRET=your_jwt_secret_key_here
EMAIL_ID=noreply@yourdomain.com
EMAIL_PASSWORD=your_email_app_password
CLOUDINARY_NAME=your_cloudinary_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
OPENAI_API_KEY=your_openai_api_key

# Twilio SMS Configuration
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx

# Optional Alternative: Fast2SMS (India)
FAST2SMS_API_KEY=your_fast2sms_api_key

# Bunny Stream Video Security Configuration
BUNNY_API_KEY=your_bunny_stream_access_key
BUNNY_LIBRARY_ID=123456
BUNNY_CDN_HOSTNAME=video.bunnycdn.com
BUNNY_VIDEO_SIGNING_KEY=your_bunny_token_authentication_key
VIDEO_PLAYBACK_TOKEN_TTL=300

# Session Management (Max 2 Active Device Logins)
MAX_ACTIVE_SESSIONS=2
# Optional Redis session store (uses MongoDB by default)
REDIS_URL=redis://localhost:6379
